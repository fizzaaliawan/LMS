# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed or pushed to DockerHub/GitHub.

# Postgres
POSTGRES_USER=library
POSTGRES_PASSWORD=changeme
POSTGRES_DB=library
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://library:changeme@db:5432/library

# Redis
REDIS_URL=redis://redis:6379/0
SEARCH_CACHE_TTL_SECONDS=60

# API auth (JWT)
# Generate a real secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Background jobs
# Loans older than this many days (with no return recorded) count as overdue
# in the /reports/overdue background job.
OVERDUE_LOAN_DAYS=14

# The scheduler checks stored due dates hourly and creates notifications.
LOAN_PERIOD_DAYS=14
CELERY_TASK_ALWAYS_EAGER=0

# DockerHub
# DOCKERHUB_TOKEN is used only in CI, set as a GitHub Actions secret - never here.
# DOCKERHUB_USERNAME is needed here too, on the EC2 box, so
# docker-compose.prod.yml knows which image to pull.
DOCKERHUB_USERNAME=your-dockerhub-username
